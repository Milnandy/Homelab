        <mxCell id="md" value="&lt;b&gt;MariaDB Server&lt;/b&gt;&lt;br&gt;Port: &lt;b&gt;3306/TCP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Peran:&lt;/b&gt;&lt;br&gt;• Menangani operasi WRITE&lt;br&gt;• Mencatat perubahan ke Binary Log (binlog)&lt;br&gt;• Mengirim event replikasi ke Slave" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BCDB3;fontColor=#244B39;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="340" width="310" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="sd" value="&lt;b&gt;MariaDB Server&lt;/b&gt;&lt;br&gt;Port: &lt;b&gt;3306/TCP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Peran:&lt;/b&gt;&lt;br&gt;• Menerima event binlog dari Master&lt;br&gt;• SQL thread menerapkan perubahan&lt;br&gt;• Menjaga salinan data tetap tersinkron" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9A9EF;fontColor=#382477;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="340" width="310" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="rep" value="Replikasi Binary Log (Binlog)&lt;br&gt;&lt;b&gt;TCP 3306 • Satu arah&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontStyle=1;fontColor=#9A4D00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="master" target="slave">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="flow" value="&lt;b&gt;ALUR REPLIKASI&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Master menerima perubahan data (WRITE).&lt;br&gt;2. Perubahan dicatat ke binary log.&lt;br&gt;3. Slave mengambil event binlog melalui koneksi replikasi.&lt;br&gt;4. Slave menerapkan perubahan pada database lokal." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#E7B65C;fontColor=#704B13;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
